@'
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local
*.pem
*.key

# Build outputs
dist/
build/
coverage/

# Docker
.docker/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Logs
logs/
*.log
'@ | Set-Content .gitignore